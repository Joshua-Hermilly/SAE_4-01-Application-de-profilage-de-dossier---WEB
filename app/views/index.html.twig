{% include '_template/header.html.twig' with {
  title: title | default('MonProjet'),
  project_name: project_name | default('MonProjet')
} %}

<main>

  {# ============================================================
     HERO
  ============================================================ #}
  <section class="hero" aria-label="Présentation du projet">
    <p class="hero-sub">PHP · MVC · Twig · Bootstrap 5.3.8</p>
    <h1 class="hero-title">
      <span class="accent">SAE S401 : </span>Développement d'une
      application complexe.
    </h1>
    <div class="hero-meta" role="list" aria-label="Stack technique">
      <span role="listitem">PHP 8.0+</span>
      <span role="listitem">Twig 3.x</span>
      <span role="listitem">Bootstrap 5.3.8</span>
      <span role="listitem">Composer</span>
    </div>
  </section>

  {# ============================================================
     TICKER DÉFILANT
  ============================================================ #}
  <div class="ticker" aria-hidden="true">
    <div class="ticker-inner">
      <span>PHP</span><span class="sep"> / </span>
      <span>TWIG</span><span class="sep"> / </span>
      <span>BOOTSTRAP</span><span class="sep"> / </span>
      <span>MVC</span><span class="sep"> / </span>
      <span>COMPOSER</span><span class="sep"> / </span>
      <span>REPOSITORIES</span><span class="sep"> / </span>
      <span>SERVICES</span><span class="sep"> / </span>
      <span>ENTITIES</span><span class="sep"> / </span>
    </div>
  </div>

  {# ============================================================
     GRILLE ARCHITECTURE
  ============================================================ #}
  <div class="arch-grid" role="list" aria-label="Architecture du projet">

    <div class="grid-col" role="listitem">
      <div class="grid-num">01</div>
      <div class="grid-label">Présentation</div>
      <div class="grid-item">
        <span class="dot dot-red"></span>
        <span>controllers/</span>
      </div>
      <div class="grid-item">
        <span class="dot dot-black"></span>
        <span>views/</span>
      </div>
      <div class="grid-item">
        <span class="dot dot-black"></span>
        <span>views/_template/</span>
      </div>
    </div>

    <div class="grid-col" role="listitem">
      <div class="grid-num">02</div>
      <div class="grid-label">Métier</div>
      <div class="grid-item">
        <span class="dot dot-red"></span>
        <span>services/</span>
      </div>
      <div class="grid-item">
        <span class="dot dot-black"></span>
        <span>entities/</span>
      </div>
    </div>

    <div class="grid-col" role="listitem">
      <div class="grid-num">03</div>
      <div class="grid-label">Données</div>
      <div class="grid-item">
        <span class="dot dot-red"></span>
        <span>repositories/</span>
      </div>
      <div class="grid-item">
        <span class="dot dot-black"></span>
        <span>config/config.php</span>
      </div>
    </div>

    <div class="grid-col" role="listitem">
      <div class="grid-num">04</div>
      <div class="grid-label">Infrastructure</div>
      <div class="grid-item">
        <span class="dot dot-yellow"></span>
        <span>core/Controller.php</span>
      </div>
      <div class="grid-item">
        <span class="dot dot-yellow"></span>
        <span>core/Repository.php</span>
      </div>
      <div class="grid-item">
        <span class="dot dot-black"></span>
        <span>vendor/ (Composer)</span>
      </div>
    </div>

  </div>

</main>

{% include '_template/footer.html.twig' %}

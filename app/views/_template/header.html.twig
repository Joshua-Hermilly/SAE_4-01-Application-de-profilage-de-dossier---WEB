<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | default('MonProjet') }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
</head>
<body>

{# Barre rouge top — nom du projet + stack #}
<div class="top-bar" role="banner" aria-label="En-tête du projet">
  <span class="top-bar-left">{{ project_name | default('MonProjet') }} — v1.0.0</span>
  <span class="top-bar-right">PHP · Twig · Bootstrap 5.3.8</span>
</div>

{# Navbar — logo seul, aucun lien #}
<nav class="navbar-brutalist" aria-label="Navigation principale">
  <span class="nav-logo">{{ project_name | default('MonProjet') }}</span>
</nav>

{% extends 'base.html.twig' %}

{% set assets = {
	css: [
		'/css/responsive.css',
		'/css/assets/filter.css',
		'/css/assets/tableau.css',
		'/css/assets/map.css',
		'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css',
		'https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css',
		'https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css'
	],
	js: [
		'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js',
		'https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js',
		'/js/filter-bac.js',
		'/js/filter-buttons.js',
		'/js/tableau.js',
		'/js/map.js',
		'/js/map-buttons.js'
	]
} %}
{% set is_admin   =  isAdmin %}
{% set pageActive = 'formations' %}

{% block content %}
	<div id="dossiers-layout" class="d-flex flex-column flex-lg-row w-100" style="flex: 1 1 auto; min-height: 0;">
		<div id="main-content" class="d-flex flex-column overflow-hidden" style="flex: 1 1 auto; min-width: 0;">
			<div class="d-flex align-items-center gap-2 py-2">
				{# On garde seulement un bandeau vide pour aligner avec les autres pages (pas de filtres ni carte) #}
			</div>

			{% include 'components/content/assets/tableau.html.twig' %}
		</div>
	</div>
{% endblock %}
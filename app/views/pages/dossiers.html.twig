{% extends 'base.html.twig' %}

{% set css_page = '/css/pages/dossiers.css' %}
{% set is_admin = true %}
{% set title = 'Dossiers' %}
{% set pageActive = 'dossiers' %}

{% block content %}

	{# Sidebar filtre (gauche, caché par défaut) #}
	{% include 'components/content/assets/filter_open.html.twig'
		with
		{
		title: filterConfig.title | default('Filtrer'),
		sections: filterConfig.sections | default([])
		}
	%}

	{# Contenu principal (toolbar + tableau) #}
	<div id="main-content" class="d-flex h-100 p-2 flex-column overflow-hidden">	

		<div class="d-flex justify-content-between align-items-center gap-2 py-2 w-100 ">
			{% include 'components/content/assets/filter_close.html.twig'
			with
			{
			title: filterConfig.title | default('Filtrer'),
			sections: filterConfig.sections | default([])
			}%}
			{% include 'components/content/assets/recherche.html.twig' %}
			{% include 'components/content/assets/map_close.html.twig' %}
		</div>

		{% include 'components/content/assets/tableau.html.twig' %}
	</div>

	{% include 'components/content/assets/map_open.html.twig' %}

{% endblock %}

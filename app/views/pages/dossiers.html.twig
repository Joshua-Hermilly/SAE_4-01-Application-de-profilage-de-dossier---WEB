{% extends 'base.html.twig' %}

{% set assets = {
	css: [
		'/css/responsive.css',
		'/css/assets/filter.css',
		'/css/assets/tableau.css',
		'/css/assets/map.css',
		'/css/assets/info.css',
		'/css/assets/import-export.css',
		'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css',
		'https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css',
		'https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css'
	],
	js: [
		'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js',
		'https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js',
		'/js/filter-bac.js',
		'/js/filter-buttons.js',
		'/js/tableau.js',
		'/js/groupe.js',
		'/js/map.js',
		'/js/map-buttons.js',
		'/js/import-export.js'
	]
} %}

{% set is_admin   =  isAdmin %}
{% set title      = 'Dossiers' %}
{% set pageActive = 'dossiers' %}

{% block content %}

	{# Sidebar filtre (gauche, caché par défaut) #}
	{% include 'components/content/assets/filter_open.html.twig'
		with
		{
		title: filterConfig.title | default('Filtrer'),
		sections: filterConfig.sections | default([])
		}
	%}

	{# Valeurs de filtres par défaut pour un groupe (voir / éditer) #}
	{% if defaultFilters is defined %}
		<script>
			window.defaultFilters = {{ defaultFilters|json_encode|raw }};
		</script>
	{% endif %}

	{# Contenu principal (toolbar + tableau) #}
	<div id="main-content" class="d-flex h-100 p-2 flex-column overflow-hidden">	

		<div class="d-flex justify-content-between align-items-stretch gap-2 py-2 w-100 ">
			{% include 'components/content/assets/filter_close.html.twig'
			with
			{
			title: filterConfig.title | default('Filtrer'),
			sections: filterConfig.sections | default([])
			}%}

			{% include 'components/content/assets/info.html.twig' 
				with
					{
						nbEtu: infoConfig.nbEtu | default(0),
						date: infoConfig.annees | default([])
					}
			%}

			{% if isAdmin %}
				{% include 'components/content/assets/import-export.html.twig' %}
			{% endif %}

			{% include 'components/content/assets/map_close.html.twig' %}
		</div>

		{% if editGroupMode is defined and editGroupMode %}
			<div class="alert alert-warning d-flex justify-content-between align-items-center mb-2" role="alert">
				<div>
					<strong>Mode édition de groupe :</strong>
					Groupe {{ editGroupName is not empty ? editGroupName : ('#' ~ editGroupId) }}
				</div>
				<div class="d-flex align-items-center gap-2">
					<input type="hidden" id="editGroupId" value="{{ editGroupId is not null ? editGroupId : '' }}">
					<input
						 type="text"
						 id="editGroupNom"
						 class="form-control form-control-sm"
						 placeholder="Nom du groupe"
						 style="max-width: 180px;"
						 value="{{ editGroupName is not null ? editGroupName : '' }}">
					<input
						 type="color"
						 id="editGroupCouleur"
						 class="form-control form-control-color"
						 style="max-width: 60px;"
						 title="Couleur du groupe"
						 value="{{ editGroupColor is not null ? editGroupColor : '#FF8800' }}">
					<input
						 type="number"
						 id="editGroupNote"
						 class="form-control form-control-sm"
						 min="0" max="20" step="0.1"
						 placeholder="Note dossier"
						 style="max-width: 120px;"
						 value="{{ editGroupNote is not null ? editGroupNote : '' }}">
					<button type="button" class="btn btn-sm btn-outline-secondary" id="btnEditGroupCancel">Quitter</button>
					<button type="button" class="btn btn-sm btn-primary" id="btnEditGroupSave">Enregistrer</button>
				</div>
			</div>
			<div id="editGroupError" class="alert alert-danger d-none mb-2" role="alert"></div>
		{% endif %}

		{% include 'components/content/assets/tableau.html.twig' %}
	</div>

	{% include 'components/content/assets/map_open.html.twig' %}

{% endblock %}

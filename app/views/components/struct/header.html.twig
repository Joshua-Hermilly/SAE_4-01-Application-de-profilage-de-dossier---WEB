<header id="main-header" class="py-3">
  	<div class="container">
  		<div class="row justify-content-center w-100">

		<!-- LEFT (responsif) -->
		<div class="col-12 col-lg-8 pb-3">
			<div id="header-left" class="d-flex align-items-center">
				<div id="avatar"></div>
				<span id="bar-menu-text" class="ms-3">{{ project_name | default('Nom de l\'application') }}</span>
			</div>
		</div>

		<!-- RIGHT (responsif) -->
		<div class="col-12 col-lg-4">
			<div id="header-right" class="d-flex gap-2">
				<button id="btnDossier"    class="active   flex-grow-1">Dossiers  </button>
				<button id="btnGroupes"    class="menu-btn flex-grow-1">Groupes   </button>
				<button id="btnFormations" class="menu-btn flex-grow-1">Formations</button>
			</div>
		</div>
	</div>
	<script src="/js/header.js"></script>
</header>
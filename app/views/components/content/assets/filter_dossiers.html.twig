<aside class="filter-sidebar js-filter-sidebar" id="filterSidebar">
	<div class="filter-header d-flex align-items-center justify-content-between mb-4">
		<span class="fw-bold d-flex align-items-center gap-2">
			<i class="bi bi-funnel"></i>
			Filtres des dossiers
		</span>
		<button type="button" class="btn-close js-filter-close" aria-label="Fermer"></button>
	</div>

	<form class="js-filter-form">
		{# Type de bacs - Filtre principal #}
		<div class="mb-3">
			<label for="filter_typeBac" class="form-label">Type de bacs</label>
			<select class="form-select filter-input" id="filter_typeBac" name="typeBac">
				<option value="">Sélectionnez un type</option>
				<option value="general">Général</option>
				<option value="technologique">Technologique</option>
				<option value="professionnel">Professionnel</option>
			</select>
		</div>

		{# Filtre Technologique #}
		<div class="bac-filter" data-bac-type="technologique" style="display: none;">
			{% include 'components/content/assets/filter/technologique.html.twig' %}
		</div>

		{# Filtre Général #}
		<div class="bac-filter" data-bac-type="general" style="display: none;">
			{% include 'components/content/assets/filter/general.html.twig' with {
				specialites: [
					'Spécialités en terminales 1',
					'Spécialités en terminales 2',
					'Spécialité abandonnée en première'
				]
			} %}
		</div>

		{# Filtre Professionnel #}
		<div class="bac-filter" data-bac-type="professionnel" style="display: none;">
			{% include 'components/content/assets/filter/professionnel.html.twig' %}
		</div>

		{# Filtres communs #}
		{% include 'components/content/assets/filter/common.html.twig' %}
	</form>
</aside>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const select = document.getElementById("filter_typeBac");
    const blocs = document.querySelectorAll(".bac-filter");

    function resetBloc(bloc) {
        const inputs = bloc.querySelectorAll("input, select, textarea");

        inputs.forEach(input => {
            if (input.type === "checkbox" || input.type === "radio") {
                input.checked = false;
            } else {
                input.value = "";
            }
        });
    }

    select.addEventListener("change", function () {
        const selectedValue = this.value;

        // cacher et reset tous les blocs
        blocs.forEach(bloc => {
            bloc.style.display = "none";
            resetBloc(bloc);
        });

        // afficher seulement le bloc correspondant
        if (selectedValue) {
            const blocToShow = document.querySelector(`[data-bac-type="${selectedValue}"]`);
            if (blocToShow) {
                blocToShow.style.display = "block";
            }
        }
    });
});
</script>
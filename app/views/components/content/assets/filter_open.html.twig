<aside id="filter_sidebar" class="d-none col-12 col-lg-3 p-0 h-lg-100 overflow-hidden">
	<div id="card-block" class="card pb-5 h-100 w-100 overflow-hidden">
		<div class="card-body body justify-content-center w-100 p-0 h-100 overflow-hidden">
			<div id="filter-scroll" class="h-100 overflow-hidden">
				<div id="filter-scroll-inner" class="h-100 overflow-auto pb-3 px-3">
					<form id="filterForm" class="filter-panel shadow-sm rounded-4">
						<div class="d-flex align-items-center justify-content-between mb-4">
							<i class="bi bi-funnel-fill text-primary fs-4"></i>
							<h5 class="mb-0 text-light">{{ title | default('Filtrer') }}</h5>
							<button type="button" class="btn btn-sm btn-outline-light" id="filter_collapse_btn">
								<i class="bi bi-chevron-up"></i>
							</button>
						</div>

						{% for section in sections %}
							<div id="filter-section" class="mb-4">
							<p id="section-title" class="text-uppercase small">{{ section.label }}</p>
								<div class="d-flex flex-column gap-3">
									{% for filter in section.filters %}
										<div class="d-flex flex-column gap-1" data-filter-name="{{ filter.name }}">
									<p id="filter-title" class="small text-white-50">{{ filter.label }}</p>
											{% if filter.type == 'text' %}
												<input class="form-control form-control-sm"
													type="text"
													id="filter_{{ filter.name }}"
													name="{{ filter.name }}"
													placeholder="{{ filter.placeholder | default('À compléter...') }}" />
											{% elseif filter.type == 'select' %}
												<select
													class="form-select form-select-sm"
													id="filter_{{ filter.name }}"
													name="{{ filter.name }}">
													<option value="">Sélectionnez...</option>
													{% for value, label in filter.options %}
														<option value="{{ value }}">{{ label }}</option>
													{% endfor %}
												</select>
											{% elseif filter.type == 'multiselect' %}
												{% if filter.name == 'specialite_spe' or filter.name == 'specialite_opt' %}
													<div id="specialite-checkboxes-{{ filter.name }}" class="list-group list-group-flush specialite-checkboxes">
														{% for option_key, option_data in filter.options %}
															{% if option_data is iterable %}
																<label id="checkbox-item" class="list-group-item specialite-checkbox-item">
																	<input class="specialite-checkbox" type="checkbox" id="filter_{{ filter.name }}_{{ loop.index }}" name="{{ filter.name }}[]" value="{{ option_data.value }}" data-code="{{ option_data.code }}" />
																	<span>{{ option_data.label }}</span>
																</label>
															{% else %}
																	<label id="checkbox-item" class="list-group-item specialite-checkbox-item">
																		<input class="form-check-input me-2" type="checkbox" id="filter_{{ filter.name }}_{{ loop.index }}" name="{{ filter.name }}[]" value="{{ option_key }}" />
																		<span>{{ option_data }}</span>
																	</label>
															{% endif %}
														{% endfor %}
													</div>
												{% else %}
													<select
														class="form-select form-select-sm"
														id="filter_{{ filter.name }}"
														name="{{ filter.name }}[]"
														multiple>
														{% for value, label in filter.options %}
															<option value="{{ value }}">{{ label }}</option>
														{% endfor %}
													</select>
												{% endif %}
											{% elseif filter.type == 'checkbox' %}
												<div class="form-check">
													<input
														class="form-check-input"
														type="checkbox"
														id="filter_{{ filter.name }}"
														name="{{ filter.name }}" />
													<p class="form-check-label text-light"> {{ filter.label }} </p>
												</div>
											{% elseif filter.type == 'number' %}
												<div class="d-flex gap-2 align-items-center">
													<input
														class="form-control form-control-sm"
														type="number"
														id="filter_{{ filter.name }}_min"
														name="{{ filter.name }}_min"
														placeholder="Min"
														min="{{ filter.min is not null ? filter.min : 0 }}"
														max="{{ filter.max is not null ? filter.max : 20 }}"
														step="0.01" />
													<span class="filter-operator fw-semibold">{{ filter.operator | default('>=') }}</span>
													<input
														class="form-control form-control-sm"
														type="number"
														id="filter_{{ filter.name }}_max"
														name="{{ filter.name }}_max"
														placeholder="Max"
														min="{{ filter.min is not null ? filter.min : 0 }}"
														max="{{ filter.max is not null ? filter.max : 20 }}"
														step="0.01" />
												</div>
											{% endif %}
										</div>
									{% endfor %}
								</div>
							</div>
						{% endfor %}

					<div class="d-grid gap-2 mt-3">
						<button type="submit" class="btn btn-primary">Appliquer</button>
						{% if isAdmin %}
							{% if pageActive == 'dossiers' %}
							<button type="button" class="btn btn-outline-light" id="btnCreerGroupe" data-action="creer-groupe">Créer un groupe</button>
							{% else %}
							<button type="button" class="btn btn-outline-light" id="btnSupr" data-action="suppr-groupe">Supprimer Groupe</button>
							{% endif %}
						{% endif %}
					</div>
				</form>

				{# Modale de création de groupe #}
				<div class="modal fade" id="createGroupModal" tabindex="-1" aria-labelledby="createGroupModalLabel" aria-hidden="true">
					<div class="modal-dialog modal-dialog-centered">
						<div class="modal-content bg-dark text-light">
							<div class="modal-header border-secondary">
								<h5 class="modal-title" id="createGroupModalLabel">Créer un groupe</h5>
								<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
							</div>
							<div class="modal-body">
								<div id="createGroupError" class="alert alert-danger d-none" role="alert"></div>
								<p id="createGroupSelectionInfo" class="small text-muted mb-3"></p>

								<form id="createGroupForm">
									<div class="mb-3">
										<label for="createGroupNom" class="form-label text-light">Nom du groupe</label>
										<input type="text" class="form-control" id="createGroupNom" name="nom" placeholder="Ex : Groupe A" required>
									</div>

									<div class="mb-3">
										<label for="createGroupCouleur" class="form-label text-light">Couleur</label>
										<input type="color" class="form-control form-control-color" id="createGroupCouleur" name="couleur" value="#FF8800" title="Choisissez une couleur">
									</div>

									<div class="mb-3">
										<label for="createGroupNote" class="form-label text-light">Note dossier (optionnel)</label>
										<input type="number" class="form-control" id="createGroupNote" name="note_dossier" min="0" max="20" step="0.1" placeholder="Ex : 15">
										<div class="form-text text-secondary">Permet de définir une note de référence pour ce groupe.</div>
									</div>
								</form>
							</div>
							<div class="modal-footer border-secondary">
								<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
								<button type="submit" form="createGroupForm" class="btn btn-primary">Créer le groupe</button>
							</div>
						</div>
					</div>
				</div>
				</div>
			</div>
		</div>
	</div>
</aside>

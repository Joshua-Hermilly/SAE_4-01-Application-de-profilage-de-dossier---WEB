<aside class="min-vh-100 d-flex align-items-center">
	<div class="container row justify-content-left w-100">
		<div class="col-md-6">

			<div id="bloc" class="card">
				<div class="card-body body p-4">

					<div class="filter-header d-flex align-items-center justify-content-between mb-4">
						<span class="fw-bold d-flex align-items-center gap-2">
							<i class="bi bi-funnel"></i>
							{{ title | default('Filtres') }}
						</span>
					</div>

					{% for section in sections %}
						<div class="mb-4">
							<label class="fw-bold d-block mb-2">{{ section.label }}</label>
							<div class="d-flex flex-column gap-3">
								{% for filter in section.filters %}
									<div class="d-flex flex-column gap-1">
										<label class="small text-uppercase text-muted">{{ filter.label }}</label>
										{% if filter.type == 'text' %}
											<input
												class="form-control"
												type="text"
												id="filter_{{ filter.name }}"
												name="{{ filter.name }}"
												placeholder="{{ filter.placeholder | default('À compléter...') }}" />
										{% elseif filter.type == 'select' %}
											<select
												class="form-control"
												id="filter_{{ filter.name }}"
												name="{{ filter.name }}">
												<option value="">Sélectionnez...</option>
												{% for value, label in filter.options %}
													<option value="{{ value }}">{{ label }}</option>
												{% endfor %}
											</select>
										{% elseif filter.type == 'multiselect' %}
											{% if filter.name == 'specialite_spe' %}
											<div class="specialite-checkboxes" style="max-height: 250px; overflow-y: auto; border: 1px solid #ddd; padding: 10px; border-radius: 4px;">
												{% for option_key, option_data in filter.options %}
													{% if option_data is iterable %}
													<div class="form-check mb-2">
														<input class="form-check-input specialite-checkbox" type="checkbox" id="filter_{{ filter.name }}_{{ loop.index }}" name="{{ filter.name }}[]" value="{{ option_data.value }}" data-code="{{ option_data.code }}" />
														<label class="form-check-label" for="filter_{{ filter.name }}_{{ loop.index }}">{{ option_data.label }}</label>
													</div>
													{% else %}
													<div class="form-check mb-2">
														<input class="form-check-input" type="checkbox" id="filter_{{ filter.name }}_{{ loop.index }}" name="{{ filter.name }}[]" value="{{ option_key }}" />
														<label class="form-check-label" for="filter_{{ filter.name }}_{{ loop.index }}">{{ option_data }}</label>
													</div>
													{% endif %}
												{% endfor %}
											</div>
											{% else %}
											<select
												class="form-control"
												id="filter_{{ filter.name }}"
												name="{{ filter.name }}[]"
												multiple>
												{% for value, label in filter.options %}
													<option value="{{ value }}">{{ label }}</option>
												{% endfor %}
											</select>
											{% endif %}
										{% elseif filter.type == 'checkbox' %}
											<div class="form-check">
												<input
													class="form-check-input"
													type="checkbox"
													id="filter_{{ filter.name }}"
													name="{{ filter.name }}" />
												<label class="form-check-label" for="filter_{{ filter.name }}"> {{ filter.label }} </label>
											</div>
										{% elseif filter.type == 'number' %}
											<div class="d-flex gap-2 align-items-center">
												<input
													class="form-control"
													type="number"
													id="filter_{{ filter.name }}_min"
													name="{{ filter.name }}_min"
													placeholder="Min"
													min="{{ filter.min is not null ? filter.min : 0 }}"
													max="{{ filter.max is not null ? filter.max : 20 }}"
													step="1" />
												<span class="fw-bold">{{ filter.operator | default('>=') }}</span>
												<input
													class="form-control"
													type="number"
													id="filter_{{ filter.name }}_max"
													name="{{ filter.name }}_max"
													placeholder="Max"
													min="{{ filter.min is not null ? filter.min : 0 }}"
													max="{{ filter.max is not null ? filter.max : 20 }}"
													step="1" />
											</div>
										{% endif %}
									</div>
								{% endfor %}
							</div>
						</div>
					{% endfor %}

				</div>
			</div>

		</div>
	</div>
</aside>


<script>
document.addEventListener("DOMContentLoaded", function () {
    const select = document.getElementById("filter_typeBac");
    const blocs = document.querySelectorAll(".bac-filter");

    function resetBloc(bloc) {
        const inputs = bloc.querySelectorAll("input, select, textarea");

        inputs.forEach(input => {
            if (input.type === "checkbox" || input.type === "radio") {
                input.checked = false;
            } else {
                input.value = "";
            }
        });
    }
    // Filtrer les spécialités en fonction de la série de bac sélectionnée
    const serieBacSelect = document.getElementById(\"filter_serie_bac\");
    const specialiteCheckboxes = document.querySelectorAll(\".specialite-checkbox\");

    function filterSpecialites() {
        const selectedSerieCode = serieBacSelect ? serieBacSelect.value : '';
        
        specialiteCheckboxes.forEach(checkbox => {
            const speCode = checkbox.getAttribute('data-code');
            const checkboxContainer = checkbox.closest(\".form-check\");
            
            if (!selectedSerieCode) {
                checkboxContainer.style.display = \"block\";
            } else if (speCode === selectedSerieCode) {
                checkboxContainer.style.display = \"block\";
            } else {
                checkboxContainer.style.display = \"none\";
                checkbox.checked = false;
            }
        });
    }

    if (serieBacSelect) {
        serieBacSelect.addEventListener(\"change\", filterSpecialites);
    }
    select.addEventListener("change", function () {
        const selectedValue = this.value;

        // cacher et reset tous les blocs
        blocs.forEach(bloc => {
            bloc.style.display = "none";
            resetBloc(bloc);
        });

        // afficher seulement le bloc correspondant
        if (selectedValue) {
            const blocToShow = document.querySelector(`[data-bac-type="${selectedValue}"]`);
            if (blocToShow) {
                blocToShow.style.display = "block";
            }
        }
    });
});
</script>
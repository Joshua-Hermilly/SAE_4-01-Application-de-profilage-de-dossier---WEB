<aside id="filter_sidebar" class="d-none col-12 col-md-3 p-0 h-100 overflow-hidden">
	<div id="card-block" class="card h-100 w-100 overflow-hidden">
		<div class="card-body body justify-content-center w-100 p-0 h-100 overflow-hidden">
			<div id="filter-scroll" class="h-100 overflow-hidden">
				<div id="filter-scroll-inner" class="h-100 overflow-auto pb-3 px-3">
					<form id="filterForm" class="filter-panel shadow-sm rounded-4">
						<div class="d-flex align-items-center justify-content-between mb-4">
							<div class="d-flex align-items-center gap-2">
								<i class="bi bi-funnel-fill text-primary fs-4"></i>
								<h5 class="mb-0 text-light">{{ title | default('Filtrer') }}</h5>
							</div>
							<button type="button" class="btn btn-sm btn-outline-light" id="filter_collapse_btn">
								<i class="bi bi-chevron-up"></i>
							</button>
						</div>

						{% for section in sections %}
							<div id="filter-section" class="mb-4">
								<label id="section-title" class="text-uppercase small">{{ section.label }}</label>
								<div class="d-flex flex-column gap-3">
									{% for filter in section.filters %}
										<div class="d-flex flex-column gap-1" data-filter-name="{{ filter.name }}">
											<label class="small text-white-50">{{ filter.label }}</label>
											{% if filter.type == 'text' %}
												<input class="form-control form-control-sm"
													type="text"
													id="filter_{{ filter.name }}"
													name="{{ filter.name }}"
													placeholder="{{ filter.placeholder | default('À compléter...') }}" />
											{% elseif filter.type == 'select' %}
												<select
													class="form-select form-select-sm"
													id="filter_{{ filter.name }}"
													name="{{ filter.name }}">
													<option value="">Sélectionnez...</option>
													{% for value, label in filter.options %}
														<option value="{{ value }}">{{ label }}</option>
													{% endfor %}
												</select>
											{% elseif filter.type == 'multiselect' %}
												{% if filter.name == 'specialite_spe' or filter.name == 'specialite_opt' %}
													<div id="specialite-checkboxes-{{ filter.name }}" class="list-group list-group-flush specialite-checkboxes">
														{% for option_key, option_data in filter.options %}
															{% if option_data is iterable %}
																<label id="checkbox-item" class="list-group-item specialite-checkbox-item">
																	<input class="specialite-checkbox" type="checkbox" id="filter_{{ filter.name }}_{{ loop.index }}" name="{{ filter.name }}[]" value="{{ option_data.value }}" data-code="{{ option_data.code }}" />
																	<span>{{ option_data.label }}</span>
																</label>
															{% else %}
																<label id="checkbox-item" class="list-group-item specialite-checkbox-item">
																	<input class="form-check-input me-2" type="checkbox" id="filter_{{ filter.name }}_{{ loop.index }}" name="{{ filter.name }}[]" value="{{ option_key }}" />
																	<span>{{ option_data }}</span>
																</label>
															{% endif %}
														{% endfor %}
													</div>
												{% else %}
													<select
														class="form-select form-select-sm"
														id="filter_{{ filter.name }}"
														name="{{ filter.name }}[]"
														multiple>
														{% for value, label in filter.options %}
															<option value="{{ value }}">{{ label }}</option>
														{% endfor %}
													</select>
												{% endif %}
											{% elseif filter.type == 'checkbox' %}
												<div class="form-check">
													<input
														class="form-check-input"
														type="checkbox"
														id="filter_{{ filter.name }}"
														name="{{ filter.name }}" />
													<label class="form-check-label text-light" for="filter_{{ filter.name }}"> {{ filter.label }} </label>
												</div>
											{% elseif filter.type == 'number' %}
												<div class="d-flex gap-2 align-items-center">
													<input
														class="form-control form-control-sm"
														type="number"
														id="filter_{{ filter.name }}_min"
														name="{{ filter.name }}_min"
														placeholder="Min"
														min="{{ filter.min is not null ? filter.min : 0 }}"
														max="{{ filter.max is not null ? filter.max : 20 }}"
														step="0.01" />
													<span class="filter-operator fw-semibold">{{ filter.operator | default('>=') }}</span>
													<input
														class="form-control form-control-sm"
														type="number"
														id="filter_{{ filter.name }}_max"
														name="{{ filter.name }}_max"
														placeholder="Max"
														min="{{ filter.min is not null ? filter.min : 0 }}"
														max="{{ filter.max is not null ? filter.max : 20 }}"
														step="0.01" />
												</div>
											{% endif %}
										</div>
									{% endfor %}
								</div>
							</div>
						{% endfor %}

						<div class="d-grid gap-2 mt-3">
							<button type="submit" class="btn btn-primary">Appliquer</button>
							<button type="button" class="btn btn-outline-light">Créer un groupe</button>
						</div>

					</form>
				</div>
			</div>
		</div>
	</div>
</aside>
<script src="/js/filter-bac.js"></script>
<script src="/js/filter-buttons.js"></script>
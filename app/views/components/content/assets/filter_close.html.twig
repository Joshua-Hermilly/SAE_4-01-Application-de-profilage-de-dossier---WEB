<div id="filter_close_bar" class="col-12 col-md-3 p-0 h-100">
	<div id="bloc" class="card w-100 h-100 overflow-hidden filter-close">
		<div class="card-body body w-100 h-100 p-0 d-flex align-items-center justify-content-center">
			<div id="filter_close_header" class="w-100">
				<div class="d-flex align-items-center justify-content-center gap-3">
					<div id="filter_close_title" class="d-flex align-items-center gap-2">
						<i class="bi bi-funnel-fill text-primary fs-4"></i>
						<h5 id="filter_close_text" class="mb-0 text-light">{{ title | default('Filtrer') }}</h5>
					</div>
					<button type="button" id="filter_expand_btn" class="btn btn-sm btn-outline-light" aria-label="Déplier les filtres">
						<i class="bi bi-chevron-down"></i>
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

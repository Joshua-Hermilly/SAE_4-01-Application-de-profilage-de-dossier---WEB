<aside id="map_sidebar" class="d-none col-12 col-md-3 p-0 h-100 overflow-hidden">
	<div id="bloc" class="card h-100 w-100 overflow-hidden">
		<div class="card-body body justify-content-center w-100 p-0 h-100 overflow-hidden">
			<div class="h-100 overflow-hidden d-flex flex-column p-3">

				<div class="d-flex align-items-center justify-content-between mb-3">
					<div class="d-flex align-items-center gap-2">
						<i class="bi bi-map text-primary fs-4"></i>
						<h5 class="mb-0 text-light">Carte</h5>
					</div>
					<button type="button" class="btn btn-sm btn-outline-light" id="map_collapse_btn" aria-label="Replier la carte">
						<i class="bi bi-chevron-up"></i>
					</button>
				</div>

				<div class="card rounded-2 border-secondary flex-grow-1 overflow-hidden">
					<div id="map" class="w-100 h-100"></div>
				</div>

			</div>
		</div>
	</div>
</aside>

<script src="/js/map.js"></script>
<script src="/js/map-buttons.js"></script>

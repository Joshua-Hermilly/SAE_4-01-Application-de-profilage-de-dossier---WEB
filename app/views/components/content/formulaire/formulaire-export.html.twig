<div class="container min-vh-100 d-flex align-items-center">
	<div class="row justify-content-center w-100">

		<div id="chargement" class="text-center"></div>

		<div  class="col-md-6" >

			<div id="bloc" class="card">
				<div class="card-body body p-4">
					<h2 id="text" class="card-title">Exporter des données</h2>

					{% if errors|default(false) %}
						<div class="alert alert-danger text-start">
							<ul>
								{% for error in errors %}
									<li>{{ error }}</li>
								{% endfor %}
							</ul>
						</div>
					{% endif %}

					<form method="POST" action="export.php" enctype="multipart/form-data">
						<div id="espacement" class="mb-3">
							<label id="text" for="annee_promotion" class="form-label">Année de promotion :</label>
								<input type="text" class="form-control" id="annee_promotion" name="annee_promotion" placeholder="Entrez l'année de promotion" required>
						</div>

						<hr id="separateur">

						<button id="btnChargement" type="submit" class="btn btn-login w-100"> Exporter</button>
					</form>
				</div>
			</div>

		</div>
	</div>
</div>

<script src="/js/chargement.js"/>
<div class="container min-vh-100 d-flex align-items-center">
	<div class="row justify-content-center w-100">
		<div class="col-md-6">

			<div id="bloc" class="card">
				<div class="card-body body p-4">
					<h2 id="text" class="card-title">Importer des données</h2>

					{% if errors|default(false) %}
						<div class="alert alert-danger text-start">
							<ul>
								{% for error in errors %}
									<li>{{ error }}</li>
								{% endfor %}
							</ul>
						</div>
					{% endif %}

					<form method="POST" action="import.php" enctype="multipart/form-data">
						<div id="espacement" class="mb-3">
							<label id="text" for="annee_promotion" class="form-label">Année de promotion :</label>
								<input type="text" class="form-control" id="annee_promotion" name="annee_promotion" placeholder="Entrez l'année de promotion" required>
						</div>

						<div id="espacement" class="mb-3">
							<label id="text" for="file" class="form-label">Choisir un fichier</label>
							<input type="file" class="form-control" id="file" name="file" accept=".xlsx,.xls,.csv" required>
							<small class="form-text text-muted">Formats acceptés : Excel (.xlsx, .xls) ou CSV</small>
						</div>

						<hr id="separateur">

						<button id="bouton" type="submit" class="btn btn-login w-100">Importer</button>
					</form>
				</div>
			</div>

		</div>
	</div>
</div>

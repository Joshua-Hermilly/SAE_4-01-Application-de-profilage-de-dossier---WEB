{# 
   Composant Toolbar - Barre d'outils sticky
   
   Paramètres:
   - showFilter: afficher le bouton filtre (défaut: true)
   - searchPlaceholder: placeholder du champ recherche (défaut: "Rechercher...")
   - filterTargetId: id de la offcanvas filtre à ouvrir (défaut: "filterOffcanvas")
#}

<div class="dossiers-toolbar sticky-top">
	<div class="container-fluid px-4">
		<div class="row align-items-center py-3 g-2">
			
			<!-- BOUTON FILTRE -->
			<div class="col-auto">
				{% if showFilter | default(true) %}
					<button 
						class="btn btn-light border-0 d-flex align-items-center gap-2"
						type="button"
						data-bs-toggle="offcanvas"
						data-bs-target="#{{ filterTargetId | default('filterOffcanvas') }}"
						aria-controls="{{ filterTargetId | default('filterOffcanvas') }}"
					>
						<i class="bi bi-funnel"></i>
						<span class="d-none d-sm-inline">Filtrer</span>
					</button>
				{% endif %}
			</div>

			<!-- RECHERCHE (flexible) -->
			<div class="col">
				<div class="input-group input-group-sm">
					<span class="input-group-text bg-light border-0">
						<i class="bi bi-search"></i>
					</span>
					<input 
						type="text" 
						class="form-control bg-light border-0"
						placeholder="{{ searchPlaceholder | default('Rechercher...') }}"
						aria-label="Rechercher"
					>
				</div>
			</div>

			<!-- ACTIONS DROITE -->
			<div class="col-auto d-flex gap-2 justify-content-end">
				<!-- Télécharger -->
				<button class="btn btn-light border-0 d-flex align-items-center gap-2" title="Télécharger">
					<i class="bi bi-download"></i>
					<span class="d-none d-md-inline">Télécharger</span>
				</button>

				<!-- Uploader -->
				<button class="btn btn-light border-0 d-flex align-items-center gap-2" title="Uploader">
					<i class="bi bi-upload"></i>
					<span class="d-none d-md-inline">Uploader</span>
				</button>

				<!-- Carte + Agrandir (combiné) -->
				<div class="btn-group" role="group">
					<button class="btn btn-light border-0 d-flex align-items-center gap-2" title="Afficher la carte">
						<i class="bi bi-map"></i>
						<span class="d-none d-lg-inline">Carte</span>
					</button>
					<button class="btn btn-light border-0" title="Agrandir">
						<i class="bi bi-fullscreen"></i>
					</button>
				</div>

				<!-- Agrandir (indépendant) -->
				<button class="btn btn-light border-0" title="Agrandir le contenu">
					<i class="bi bi-chevron-expand"></i>
				</button>
			</div>

		</div>
	</div>
</div>

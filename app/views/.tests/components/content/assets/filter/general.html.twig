{# Filtres spécifiques au bac Général #}

{# Spécialités en terminales (2 filtres avec boucle) #}
{% for specialite in specialites %}
	<div class="mb-3" data-bac-type="general">
		<label for="filter_specialitesTerminales_{{ loop.index }}" class="form-label">{{ specialite }}</label>
		<select class="form-select filter-input" id="filter_specialitesTerminales_{{ loop.index }}" name="specialitesTerminales_{{ loop.index }}">
			<option value="">Sélectionnez une spécialité</option>
			<option value="svt">SVT</option>
			<option value="physique-chimie">Physique-Chimie</option>
			<option value="langues">Langues et cultures étrangères</option>
			<option value="ses">SES</option>
			<option value="innovation">Innovation Technologique</option>
			<option value="mathematiques">Math</option>
			<option value="gestion-numerique">Gestion et numérique</option>
			<option value="sciences-ingenieur">SI</option>
			<option value="numerique-informatique">NSI</option>
			<option value="histoire-geographie">HGGSP</option>
			<option value="humanites">Humanités et Littérature</option>
			<option value="biochimie">Biochimie-Biologie</option>
			<option value="physique-sante">Physique-Chimie santé</option>
			<option value="arts">Arts Plastiques</option>
			<option value="economie-environnement">Economie et environnement</option>
			<option value="cinema">Cinéma-Audiovisuel</option>
			<option value="musique">Musique</option>
			<option value="histoire-arts">Histoire des Arts</option>
			<option value="latin">Latin</option>
		</select>
	</div>
{% endfor %}

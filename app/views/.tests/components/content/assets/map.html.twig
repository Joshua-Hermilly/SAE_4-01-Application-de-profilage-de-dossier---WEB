{# 
   Composant Map - Panneau carte et légende
   
   Paramètres:
   - title: titre du panneau (défaut: "Localisation")
   - legend: array de groupes pour légende [{ name, color }, ...]
   - mapContainerId: id du conteneur carte (défaut: "mapContainer")
#}

<div class="dossiers-map">
	
	<!-- HEADER DE LA CARTE -->
	<div class="map-header">
		<h5 class="mb-0">
			<i class="bi bi-map"></i>
			{{ title | default('Localisation') }}
		</h5>
	</div>

	<!-- CONTENEUR CARTE -->
	<div id="{{ mapContainerId | default('mapContainer') }}" class="map-container">
		<div class="map-placeholder d-flex align-items-center justify-content-center h-100">
			<div class="text-center text-muted">
				<i class="bi bi-map" style="font-size: 3rem; opacity: 0.3;"></i>
				<p class="small">Carte à intégrer</p>
			</div>
		</div>
	</div>

	<!-- LÉGENDE -->
	{% if legend is defined and legend is not empty %}
		<div class="map-legend">
			<h6 class="text-uppercase small fw-semibold mb-2">Légende</h6>
			<div class="legend-items">
				{% for item in legend %}
					<div class="legend-item">
						<span class="legend-color" style="background-color: {{ item.color | default('#cccccc') }}"></span>
						<span class="legend-label">{{ item.name | default('Groupe') }}</span>
					</div>
				{% endfor %}
			</div>
		</div>
	{% else %}
		<div class="map-legend">
			<h6 class="text-uppercase small fw-semibold mb-2">Légende des Groupes</h6>
			<div class="legend-items">
				<div class="legend-item">
					<span class="legend-color" style="background-color: #2158BD"></span>
					<span class="legend-label">Groupe A</span>
				</div>
				<div class="legend-item">
					<span class="legend-color" style="background-color: #6CB4E5"></span>
					<span class="legend-label">Groupe B</span>
				</div>
				<div class="legend-item">
					<span class="legend-color" style="background-color: #A8D5BA"></span>
					<span class="legend-label">Groupe C</span>
				</div>
			</div>
		</div>
	{% endif %}

</div>
